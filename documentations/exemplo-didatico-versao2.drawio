<mxfile host="app.diagrams.net" agent="Claude" type="device"><diagram id="visao-v2" name="1 · Visão geral"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Jornada de uma frase do PHOENIX-2014T pelo SkeLTrans (versao2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry" /></mxCell><mxCell id="st" value="Exemplo ilustrativo: “morgen regnet es im norden” (glosas MORGEN NORD REGEN) · 100 frames = 4 s a 25 fps · formatos e regras conforme o código" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1500" height="20" as="geometry" /></mxCell><mxCell id="j1" value="1 · Vídeo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="70" as="geometry" /></mxCell><mxCell id="j1d" value="100 frames PNG&#10;210×260 px, 25 fps" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="160" height="60" as="geometry" /></mxCell><mxCell id="j2" value="2 · Keypoints" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="160" height="70" as="geometry" /></mxCell><mxCell id="j2d" value="MediaPipe: 115 pontos × 3&#10;mão esq. some em parte dos frames" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=