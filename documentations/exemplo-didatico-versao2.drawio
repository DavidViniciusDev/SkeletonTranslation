ll id="t3b5" value="13,9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b6" value="14,0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b7" value="13,8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="650" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b8" value="14,1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b9" value="13,7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b10" value="13,9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b11" value="13,5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b12" value="13,6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b13" value="13,4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="950" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3b14" value="13,3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="658" width="46" height="34" as="geometry" /></mxCell><mxCell id="t3l1" value="época 10: 14,2 → best.pt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="240" height="40" as="geometry" /></mxCell><mxCell id="t3l2" value="épocas 12–30: nenhuma passa de 14,2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="710" width="250" height="40" as="geometry" /></mxCell><mxCell id="t3l3" value="época 30: 20 épocas sem melhora → para" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="710" width="230" height="40" as="geometry" /></mxCell><mxCell id="t3v" value="val_loss no dev: menor valor na época 7 → best_loss.pt" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="420" height="50" as="geometry" /></mxCell><mxCell id="t3w" value="Sem --select-by (critério val_loss), o best.pt seria a época 7 e o treino pararia na época 27, sem ver o pico de BLEU-4 da época 10. Com o best_loss.pt salvo, dá para comparar os dois critérios no mesmo treino." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="835" widt