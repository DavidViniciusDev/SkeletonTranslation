yle="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="160" height="55" as="geometry" /></mxCell><mxCell id="j8" value="7b · CTC head" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="220" width="160" height="55" as="geometry" /></mxCell><mxCell id="o1" value="“morgen regnet es im norden”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="260" height="55" as="geometry" /></mxCell><mxCell id="o2" value="MORGEN NORD REGEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="220" width="260" height="55" as="geometry" /></mxCell><mxCell id="je6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="j6" target="j7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="je7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#78350F;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="j6" target="j8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="je8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j7" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="je9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#78350F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="j8" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ann" value="Anotação do PHOENIX (manifesto)&#10;text: morgen regnet es im norden&#10;tokens: MORGEN NORD REGEN" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="360" height="75" as="geometry" /></mxCell><mxCell id="k1" value="alvo do CTC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=11;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="ann" target="o2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="357" /></Array></mxGeometry></mxCell><mxCell id="k2" value="alvo do decoder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=11;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="ann" target="o1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="342" /><mxPoint x="1700" y="127" /></Array></mxGeometry></mxCell><mxCell id="idea" value="A ideia: o mesmo encoder alimenta duas saídas. O decoder escreve a tradução (é o que o BLEU mede); o CTC reconhece os sinais (é o que o WER mede) e, durante o treino, força o encoder a separar bem cada sinal. Os blocos em amarelo são o que a versao2 acrescentou." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="1220" height="75" as="geometry" /></mxCell><mxCell id="lg" value="Legenda" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="200" height="20" as="geometry" /></mxCell><mxCell id="lg1" value="Novo na versao2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="448" width="150" height="34" as="geometry" /></mxCell><mxCell id="lg2" value="Processamento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="448" width="140" height="34" as="geometry" /></mxCell><mxCell id="lg3" value="Pré-treinado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="448" width="130" height="34" as="geometry" /></mxCell><mxCell id="lg4" value="Arquivo / tensor" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="490" y="446" width="140" height="38" as="geometry" /></mxCell><mxCell id="lg5" value="Resultado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="448" width="120" height="34" as="geometry" /></mxCell><mxCell id="lg6" value="Não executado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#9CA3AF;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="448" width="130" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="dados-v2" name="2 · Dados: vídeo → entrada"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1340" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Aba 2 · Do vídeo do PHOENIX à entrada do encoder" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry" /></mxCell><mxCell id="st" value="Exemplo: “morgen regnet es im norden” · MORGEN NORD REGEN · 100 frames · valores numéricos ilustrativos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1350" height="20" as="geometry" /></mxCell><mxCell id="hd1" value="ETAPA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="230" height="20" as="geometry" /></mxCell><mxCell id="hd2" value="O QUE ACONTECE COM O EXEMPLO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="760" height="20" as="geometry" /></mxCell><mxCell id="hd3" value="POR QUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="300" height="20" as="geometry" /></mxCell><mxCell id="r1" value="1 · Anotação e vídeo&#10;&#10;manifesto + 100 frames" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="170" as="geometry" /></mxCell><mxCell id="r1_pq" value="Por que existe&#10;O PHOENIX já traz a frase contínua filmada: não há colagem de sinais nem transições sintéticas.&#10;Cada item tem a tradução (alvo do decoder) e as glosas (alvo do CTC)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="300" height="170" as="geometry" /></mxCell><mxCell id="r1a" value="{&#10;  &quot;features&quot;: &quot;.../dev/01April_2010_..._.npy&quot;,&#10;  &quot;text&quot;:   &quot;morgen regnet es im norden&quot;,&#10;  &quot;tokens&quot;: &quot;MORGEN&quot;, &quot;NORD&quot;, &quot;REGEN&quot;&#10;}" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="460" height="95" as="geometry" /></mxCell><mxCell id="r1b" value="dev.json (phoenix_prepare.py)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="300" height="20" as="geometry" /></mxCell><mxCell id="r1f0" value="f1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f1" value="f2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="824" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f2" value="f3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="858" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f3" value="…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="892" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f4" value="f50" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="926" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f5" value="…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f6" value="f99" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="994" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1f7" value="f100" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1028" y="110" width="30" height="70" as="geometry" /></mxCell><mxCell id="r1c" value="frames 210×260 px · 25 fps · 100 frames = 4 s" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="790" y="190" width="300" height="20" as="geometry" /></mxCell><mxCell id="r1d" value="Glosas em alemão; a tradução tem mais palavras (artigos, verbo flexionado) do que as glosas: o decoder precisa gerá-las." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="235" width="760" height="30" as="geometry" /></mxCell><mxCell id="r2" value="2 · Keypoints (MediaPipe)&#10;&#10;por frame: 115 × 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="230" as="geometry" /></mxCell><mxCell id="r2_pq" value="Por que existe&#10;Mãos de ~35 px e borradas pelo movimento: o MediaPipe as perde em ~26% dos frames, e em ~10% perde as duas.&#10;Ponto não detectado vira [0, 0, 0]." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="300" height="230" as="geometry" /></mxCell><mxCell id="r2c" value="Linha do tempo (1 frame = 7 px) e presença da mão esquerda:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="305" width="760" height="20" as="geometry" /></mxCell><mxCell id="r2s1" value="MORGEN · fr 0–29" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="210" height="34" as="geometry" /></mxCell><mxCell id="r2s2" value="NORD · fr 30–59" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="330" width="210" height="34" as="geometry" /></mxCell><mxCell id="r2s3" value="REGEN · fr 60–99" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="280" height="34" as="geometry" /></mxCell><mxCell id="r2h1" value="mão esq. detectada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="280" height="28" as="geometry" /></mxCell><mxCell id="r2h2" value="ausente · fr 40–64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;dashed=1;fontColor=#7F1D1D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="370" width="175" height="28" as="geometry" /></mxCell><mxCell id="r2h3" value="mão esq. detectada" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="755" y="370" width="245" height="28" as="geometry" /></mxCell><mxCell id="r2m" value="Frame 50 (dentro de NORD):&#10;pose 11 · ombro   x=0,58  y=0,47  z=-0,04&#10;pose 15 · pulso   x=0,63  y=0,38  z=-0,10&#10;mão esq. (21 pts) [0, 0, 0]  &lt;- não detectada" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="460" height="85" as="geometry" /></mxCell><mxCell id="r2n" value="Sem transições sintéticas: a passagem de um sinal para o outro é a real." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="790" y="415" width="270" height="60" as="geometry" /></mxCell><mxCell id="r3" value="3 · Normalização (s4)&#10;&#10;100 × 115 × 3 → 100 × 115 × 9" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="230" height="160" as="geometry" /></mxCell><mxCell id="r3_pq" value="Por que existe&#10;Igual à versao1: tira a posição e a escala do corpo no quadro e entrega o movimento pronto (velocidade e aceleração)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="560" width="300" height="160" as="geometry" /></mxCell><mxCell id="r3a" value="centraliza no meio dos ombros e divide pela distância entre eles&#10;V = P(t) − P(t−1)      A = V(t) − V(t−1)&#10;ausente continua 0; V só é calculada se o ponto existe em t e em t−1" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="760" height="65" as="geometry" /></mxCell><mxCell id="r3b" value="Resultado: 100 frames × 115 pontos × 9 canais = 1035 números por frame (a entrada da versao1)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="645" width="760" height="30" as="geometry" /></mxCell><mxCell id="r4" value="4 · Features extras A,F&#10;(no Dataset)&#10;&#10;1035 → 1215 colunas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="230" height="260" as="geometry" /></mxCell><mxCell id="r4_pq" value="Por que existe&#10;Um Linear teria de descobrir ângulos de dedo a partir de coordenadas soltas; o grupo A entrega a configuração de mão pronta, independente de onde a mão está e do tamanho dela.&#10;O grupo F diz que aquele 0 significa “mão não detectada”, e não “mão na origem”." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="750" width="300" height="260" as="geometry" /></mxCell><mxCell id="r4a" value="A · configuração de mão (176 colunas, 88 por mão)&#10;  • mão centrada no punho e ÷ tamanho da palma&#10;  • flexão das 15 articulações dos dedos (radianos):&#10;      indicador esticado = 3,14   dobrado ≈ 1,6&#10;  • distância entre as 5 pontas ÷ palma" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="760" width="470" height="110" as="geometry" /></mxCell><mxCell id="r4b" value="F · presença (4 colunas)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="780" y="760" width="260" height="20" as="geometry" /></mxCell><mxCell id="r4f0" value="pose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="785" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4f1" value="m. esq" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="844" y="785" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4f2" value="m. dir" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="908" y="785" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4f3" value="face" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="972" y="785" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4g0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="820" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4g1" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="820" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4g2" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="820" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4g3" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="972" y="820" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4h0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="855" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4h1" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="855" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4h2" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="908" y="855" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4h3" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="972" y="855" width="60" height="30" as="geometry" /></mxCell><mxCell id="r4l1" value="frame 10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1036" y="825" width="54" height="20" as="geometry" /></mxCell><mxCell id="r4l2" value="frame 50" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1036" y="860" width="54" height="20" as="geometry" /></mxCell><mxCell id="r4c" value="No frame 50 a mão esquerda sumiu: as 88 colunas de A dela ficam 0 e o F marca 0 na presença." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="880" width="760" height="20" as="geometry" /></mxCell><mxCell id="r4t0" value="1035 · Passo 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="905" width="250" height="34" as="geometry" /></mxCell><mxCell id="r4t1" value="+ 176 · grupo A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="556" y="905" width="250" height="34" as="geometry" /></mxCell><mxCell id="r4t2" value="+ 4 · grupo F  =  1215" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="812" y="905" width="250" height="34" as="geometry" /></mxCell><mxCell id="r5" value="5 · Input-norm (z-score)&#10;&#10;100 × 1215 → 100 × 1215" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="230" height="190" as="geometry" /></mxCell><mxCell id="r5_pq" value="Por que existe&#10;Radianos, razões e 0/1 têm escalas muito diferentes; sem normalizar, as colunas de maior valor dominariam a projeção.&#10;As estatísticas vêm só do treino (nada do dev ou do teste vaza) e ficam dentro do .pt." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1040" width="300" height="190" as="geometry" /></mxCell><mxCell id="r5a" value="coluna “ângulo do indicador dir.”: média 2,40  desvio 0,60 (do TREINO)&#10;   frame 50: 3,14  -&gt;  (3,14 − 2,40) ÷ 0,60 = 1,23&#10;&#10;coluna “presença mão esq.”:      média 0,72  desvio 0,45&#10;   frame 50: 0     -&gt;  (0 − 0,72) ÷ 0,45 = −1,60&#10;&#10;frames de padding continuam exatamente 0" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="1050" width="620" height="125" as="geometry" /></mxCell><mxCell id="next" value="Segue para o encoder → aba 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="230" height="45" as="geometry" /></mxCell><mxCell id="nxr1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nxr2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nxr3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nxr4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nxr5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r5" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="modelo-v2" name="3 · Encoder e saídas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Aba 3 · O encoder da versao2 e as duas saídas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry" /></mxCell><mxCell id="st" value="skeltrans/training/models · d_model 512 · ds_steps 2 · 6 camadas · 8 cabeças · valores de atenção e de CTC ilustrativos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1350" height="20" as="geometry" /></mxCell><mxCell id="hd1" value="ETAPA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="230" height="20" as="geometry" /></mxCell><mxCell id="hd2" value="O QUE ACONTECE COM O EXEMPLO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="760" height="20" as="geometry" /></mxCell><mxCell id="hd3" value="POR QUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="300" height="20" as="geometry" /></mxCell><mxCell id="m1" value="Projeção por partes&#10;(--encoder-type parts)&#10;&#10;100 × 1215 → 100 × 512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="270" as="geometry" /></mxCell><mxCell id="m1_pq" value="Por que existe&#10;No flat, um Linear único mistura as 1215 colunas: para ele, dois dedos vizinhos não têm mais relação que um dedo e uma sobrancelha, e as mãos disputam a projeção com os 40 pontos da face.&#10;O ganho, se houver, vem da estrutura: a versão por partes tem MENOS parâmetros." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="300" height="270" as="geometry" /></mxCell><mxCell id="m1i0" value="pose · 297 colunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="190" height="34" as="geometry" /></mxCell><mxCell id="m1m0" value="Linear → GELU → Linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="200" height="34" as="geometry" /></mxCell><mxCell id="m1o0" value="128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="70" height="34" as="geometry" /></mxCell><mxCell id="m1e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1i0" target="m1m0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1m0" target="m1o0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1i1" value="mão esq. · 189 colunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="152" width="190" height="34" as="geometry" /></mxCell><mxCell id="m1m1" value="Linear → GELU → Linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="152" width="200" height="34" as="geometry" /></mxCell><mxCell id="m1o1" value="128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="152" width="70" height="34" as="geometry" /></mxCell><mxCell id="m1e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1i1" target="m1m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1m1" target="m1o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1i2" value="mão dir. · 189 colunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="194" width="190" height="34" as="geometry" /></mxCell><mxCell id="m1m2" value="Linear → GELU → Linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="194" width="200" height="34" as="geometry" /></mxCell><mxCell id="m1o2" value="128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="194" width="70" height="34" as="geometry" /></mxCell><mxCell id="m1e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1i2" target="m1m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1m2" target="m1o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1i3" value="face · 360 colunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="236" width="190" height="34" as="geometry" /></mxCell><mxCell id="m1m3" value="Linear → GELU → Linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="236" width="200" height="34" as="geometry" /></mxCell><mxCell id="m1o3" value="128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="236" width="70" height="34" as="geometry" /></mxCell><mxCell id="m1e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1i3" target="m1m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1m3" target="m1o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1i4" value="extras A,F · 180 colunas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="278" width="190" height="34" as="geometry" /></mxCell><mxCell id="m1m4" value="Linear → GELU → Linear" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="278" width="200" height="34" as="geometry" /></mxCell><mxCell id="m1o4" value="128" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="278" width="70" height="34" as="geometry" /></mxCell><mxCell id="m1e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1i4" target="m1m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1f4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1m4" target="m1o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1c" value="concatena&#10;5 × 128&#10;= 640" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="70" height="202" as="geometry" /></mxCell><mxCell id="m1f" value="Linear&#10;640 → 512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="176" width="110" height="70" as="geometry" /></mxCell><mxCell id="m1g" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1c" target="m1f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m1t" value="0,57 M parâmetros (o flat teria 0,62 M com A,F). Mudar a face não altera o que sai do fluxo da mão: cada parte é isolada até a fusão." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="325" width="760" height="40" as="geometry" /></mxCell><mxCell id="m2" value="Conv k=3 + Downsampling × 2&#10;&#10;100 → 50 → 25 posições" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="230" height="200" as="geometry" /></mxCell><mxCell id="m2_pq" value="Por que existe&#10;PHOENIX: mediana de 110 frames ≈ 28 posições para ~7 glosas, folga suficiente para o CTC, que precisa de pelo menos uma posição por glosa.&#10;Com --ds-steps 8 (o v7), a frase virava 1 posição e o CTC não funcionava." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="400" width="300" height="200" as="geometry" /></mxCell><mxCell id="m2c" value="100 frames (7 px por frame):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="405" width="300" height="20" as="geometry" /></mxCell><mxCell id="m2a1" value="MORGEN · 30 frames" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="428" width="210" height="32" as="geometry" /></mxCell><mxCell id="m2a2" value="NORD · 30 frames" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="510" y="428" width="210" height="32" as="geometry" /></mxCell><mxCell id="m2a3" value="REGEN · 40 frames" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="428" width="280" height="32" as="geometry" /></mxCell><mxCell id="m2c2" value="25 posições depois do downsampling (28 px por posição):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="400" height="20" as="geometry" /></mxCell><mxCell id="m2b1" value="MORGEN · pos 0–7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="493" width="224" height="32" as="geometry" /></mxCell><mxCell id="m2b2" value="NORD · pos 8–14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="524" y="493" width="196" height="32" as="geometry" /></mxCell><mxCell id="m2b3" value="REGEN · pos 15–24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="493" width="280" height="32" as="geometry" /></mxCell><mxCell id="m2t" value="Cada posição resume 4 frames e enxerga 15 (0,6 s a 25 fps). Máscara: 100 → 50 → 25 posições válidas." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="535" width="760" height="40" as="geometry" /></mxCell><mxCell id="m3" value="LayerNorm · PE ·&#10;Transformer × 6&#10;&#10;25 × 512 → 25 × 512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="230" as="geometry" /></mxCell><mxCell id="m3_pq" value="Por que existe&#10;Até aqui cada posição só via ~15 frames. A atenção liga trechos distantes: o REGEN “descobre” onde (NORD) e quando (MORGEN).&#10;LayerNorm e PE funcionam como na versao1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="630" width="300" height="230" as="geometry" /></mxCell><mxCell id="m3c" value="Quanto cada região presta atenção às outras (cada linha soma 1):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="635" width="600" height="20" as="geometry" /></mxCell><mxCell id="m3h0" value="MORGEN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="400" y="660" width="88" height="24" as="geometry" /></mxCell><mxCell id="m3h1" value="NORD" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="490" y="660" width="88" height="24" as="geometry" /></mxCell><mxCell id="m3h2" value="REGEN" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="580" y="660" width="88" height="24" as="geometry" /></mxCell><mxCell id="m3r0" value="MORGEN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="688" width="95" height="36" as="geometry" /></mxCell><mxCell id="m3v00" value="0,60" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="688" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v01" value="0,15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="688" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v02" value="0,25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="688" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3r1" value="NORD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="728" width="95" height="36" as="geometry" /></mxCell><mxCell id="m3v10" value="0,15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="728" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v11" value="0,55" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="728" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v12" value="0,30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="728" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3r2" value="REGEN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="768" width="95" height="36" as="geometry" /></mxCell><mxCell id="m3v20" value="0,20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="768" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v21" value="0,30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="768" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3v22" value="0,50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="768" width="88" height="36" as="geometry" /></mxCell><mxCell id="m3x" value="Leitura: a linha REGEN dá 30% da atenção a NORD e 20% a MORGEN. Padding sempre recebe 0." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="688" width="360" height="116" as="geometry" /></mxCell><mxCell id="m4" value="Adapter → memory&#10;&#10;25 × 512 → 25 × 768" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="230" height="130" as="geometry" /></mxCell><mxCell id="m4_pq" value="Por que existe&#10;O decoder do T5 trabalha com vetores de 768; o adapter faz a ponte." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="890" width="300" height="130" as="geometry" /></mxCell><mxCell id="m4a" value="25 × 512" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="150" height="50" as="geometry" /></mxCell><mxCell id="m4b" value="Linear 512 → 768" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="920" width="180" height="50" as="geometry" /></mxCell><mxCell id="m4c" value="memory · 25 × 768&#10;+ máscara (25 válidas)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="760" y="910" width="300" height="70" as="geometry" /></mxCell><mxCell id="m4e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4a" target="m4b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4b" target="m4c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5" value="Duas saídas da memory&#10;&#10;decoder (texto) · CTC (glosas)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="230" height="330" as="geometry" /></mxCell><mxCell id="m5_pq" value="Por que existe&#10;O CTC não precisa saber onde cada sinal começa: ele considera todos os alinhamentos possíveis entre as 25 posições e as 3 glosas.&#10;Aqui o WER é 0. No seu melhor run, o WER de teste ficou em ~45: o encoder ainda erra quase metade das glosas." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1050" width="300" height="330" as="geometry" /></mxCell><mxCell id="m5a" value="Decoder T5 · cross-attention nas 25 posições, uma palavra por vez" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1060" width="420" height="50" as="geometry" /></mxCell><mxCell id="m5b" value="“morgen regnet es im norden”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="1060" width="300" height="50" as="geometry" /></mxCell><mxCell id="m5e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m5a" target="m5b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5c" value="CTC head: a glosa mais provável em cada posição (– = blank; M = MORGEN, N = NORD, R = REGEN)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1125" width="760" height="20" as="geometry" /></mxCell><mxCell id="m5s0" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s1" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="328" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s2" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="356" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s3" value="M" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="384" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s4" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="412" y="1150" width="26" height="30" as="geometry" /></mx