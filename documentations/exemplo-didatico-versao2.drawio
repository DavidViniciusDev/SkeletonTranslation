d=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="664" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s14" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="692" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s15" value="R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s16" value="R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="748" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s17" value="R" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="776" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s18" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="804" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s19" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="832" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s20" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="860" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s21" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="888" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s22" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="916" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s23" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="944" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5s24" value="–" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="972" y="1150" width="26" height="30" as="geometry" /></mxCell><mxCell id="m5d1" value="1. argmax por posição (acima)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="1195" width="230" height="50" as="geometry" /></mxCell><mxCell id="m5d2" value="2. colapsa repetições seguidas&#10;– M – N – R –" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="545" y="1195" width="240" height="50" as="geometry" /></mxCell><mxCell id="m5d3" value="3. remove os blanks&#10;MORGEN NORD REGEN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1195" width="260" height="50" as="geometry" /></mxCell><mxCell id="m5e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m5d1" target="m5d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m5d2" target="m5d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m5t" value="A ordem importa: colapsar antes de remover os blanks preserva sinais iguais em sequência (ex.: NORD – NORD = dois sinais)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1255" width="760" height="40" as="geometry" /></mxCell><mxCell id="mxm1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mxm2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mxm3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="mxm4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="treino-v2" name="4 · Treino e seleção"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="960" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Aba 4 · Um passo de treino e a escolha do checkpoint" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry" /></mxCell><mxCell id="st" value="--ctc-weight 0,3 · --lr 5e-5 · --encoder-lr 5e-4 · --warmup-steps 800 · batch 64 · --eval-every 2 · --select-by bleu4 · --patience 20 · valores ilustrativos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1350" height="20" as="geometry" /></mxCell><mxCell id="hd1" value="ETAPA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="230" height="20" as="geometry" /></mxCell><mxCell id="hd2" value="O QUE ACONTECE COM O EXEMPLO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="760" height="20" as="geometry" /></mxCell><mxCell id="hd3" value="POR QUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="300" height="20" as="geometry" /></mxCell><mxCell id="t1" value="Perda de um lote&#10;&#10;L = CE + λ · CTC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="230" as="geometry" /></mxCell><mxCell id="t1_pq" value="Por que existe&#10;O CTC só alcança o encoder e a CTC head; o decoder aprende apenas com a CE.&#10;Aumentar λ puxa o encoder para reconhecer sinais (o WER cai), até ele começar a descartar o que a tradução precisa." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="300" height="230" as="geometry" /></mxCell><mxCell id="tce" value="CE (tradução) = 2,10" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="170" height="45" as="geometry" /></mxCell><mxCell id="tct" value="CTC (glosas) = 3,00" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="170" height="45" as="geometry" /></mxCell><mxCell id="tdec" value="decoder T5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="200" height="40" as="geometry" /></mxCell><mxCell id="tenc" value="encoder de landmarks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="175" width="200" height="40" as="geometry" /></mxCell><mxCell id="thd" value="CTC head" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="200" height="40" as="geometry" /></mxCell><mxCell id="tg1" value="gradiente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tce" target="tdec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tg2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tce" target="tenc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tg3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#78350F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tct" target="tenc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tg4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#78350F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tct" target="thd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tm" value="λ = --ctc-weight = 0,3&#10;&#10;L = 2,10 + 0,3 × 3,00&#10;  = 3,00&#10;&#10;train_loss inclui o CTC;&#10;val_loss é só a CE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="260" height="170" as="geometry" /></mxCell><mxCell id="t2" value="lr por grupo&#10;(--encoder-lr)&#10;&#10;2 grupos, mesma agenda" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="230" height="210" as="geometry" /></mxCell><mxCell id="t2_pq" value="Por que existe&#10;O encoder começa do zero e precisa de passos maiores; o decoder já sabe alemão, e passos grandes apagariam esse conhecimento." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="360" width="300" height="210" as="geometry" /></mxCell><mxCell id="t2c" value="7.096 frases ÷ 64 = 111 passos por época × 200 épocas = 22.200 passos (se não parar antes):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="365" width="760" height="20" as="geometry" /></mxCell><mxCell id="t2h0" value="passo" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2h1" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="426" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2h2" value="400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="552" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2h3" value="800" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="678" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2h4" value="11.500" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="804" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2h5" value="22.200" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="395" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d0" value="decoder T5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d1" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="426" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d2" value="2,5e-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="552" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d3" value="5e-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="678" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d4" value="2,5e-5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="804" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2d5" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="433" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e0" value="encoder + CTC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e1" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="426" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e2" value="2,5e-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="552" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e3" value="5e-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="678" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e4" value="2,5e-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="804" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2e5" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="471" width="120" height="32" as="geometry" /></mxCell><mxCell id="t2t" value="Warmup linear até o passo 800 (pico) e decaimento linear até 0. A razão entre os dois lrs (10×) é a mesma em todos os passos." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="515" width="760" height="40" as="geometry" /></mxCell><mxCell id="t3" value="Escolha do checkpoint&#10;(--select-by bleu4)&#10;&#10;best.pt = maior BLEU-4 no dev" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="230" height="330" as="geometry" /></mxCell><mxCell id="t3_pq" value="Por que existe&#10;A val_loss mede a probabilidade palavra a palavra com a resposta certa dada; o BLEU mede a frase que o modelo gera sozinho.&#10;Elas discordam quando o modelo fica confiante demais: a loss sobe enquanto o BLEU ainda melhora.&#10;Avalie no TESTE só o best.pt final." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="600" width="300" height="330" as="geometry" /></mxCell><mxCell id="t3c" value="BLEU-4 no dev, a cada 2 épocas (beam 4):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="605" width="400" height="20" as="geometry" /></mxCell><mxCell id="t3e0" value="ep 2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e1" value="ep 4" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="350" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e2" value="ep 6" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="400" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e3" value="ep 8" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="450" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e4" value="ep 10" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="500" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e5" value="ep 12" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="550" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e6" value="ep 14" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e7" value="ep 16" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="650" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e8" value="ep 18" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="700" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e9" value="ep 20" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="750" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e10" value="ep 22" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="800" y="630" width="46" height="26" as="geometry" /></mxCell><mxCell id="t3e11" value="ep 24" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="850" y="630" width="46" height="26" as="geometry" />