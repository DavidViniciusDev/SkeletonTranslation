0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="490" y="1116" width="140" height="38" as="geometry" /></mxCell><mxCell id="lg5" value="Resultado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="1118" width="120" height="34" as="geometry" /></mxCell><mxCell id="lg6" value="Não executado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#9CA3AF;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="1118" width="130" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="treino-v2" name="versao2 — Treino e seleção"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="SkeLTrans versao2 — Treino, lr por grupo e escolha do checkpoint" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry" /></mxCell><mxCell id="st" value="skeltrans/training/trainer.py · --encoder-lr · --eval-every · --select-by bleu4 · --patience · valores de lr do exemplo: --lr 5e-5, --encoder-lr 5e-4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1350" height="20" as="geometry" /></mxCell><mxCell id="t1" value="training_config.json&#10;config completa + dados da execução" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="250" height="70" as="geometry" /></mxCell><mxCell id="t2" value="input-norm: média e desvio por coluna&#10;calculados no TREINO&#10;(dev e teste nunca entram)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="250" height="70" as="geometry" /></mxCell><mxCell id="t3" value="gloss_vocab.json&#10;glosas do treino + blank (0) e unk (1)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="250" height="70" as="geometry" /></mxCell><mxCell id="t4" value="AdamW (8-bit com --low-vram)&#10;2 grupos de parâmetros" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="250" height="70" as="geometry" /></mxCell><mxCell id="t0" value="Antes da 1ª época" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1150" y="120" width="200" height="30" as="geometry" /></mxCell><mxCell id="gl" value="Grupos de learning rate (--encoder-lr)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#D1D5DB;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#6B7280;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="1090" height="180" as="geometry" /></mxCell><mxCell id="g1" value="Decoder T5 (pré-treinado)&#10;lr = --lr (ex.: 5e-5)&#10;passos pequenos: já sabe alemão" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="330" height="100" as="geometry" /></mxCell><mxCell id="g2" value="Encoder de landmarks + CTC head&#10;lr = --encoder-lr (ex.: 5e-4)&#10;passos maiores: começa do zero" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="240" width="330" height="100" as="geometry" /></mxCell><mxCell id="g3" value="Mesma agenda nos dois grupos: warmup linear (--warmup-steps) e decaimento linear até 0. A proporção entre os lrs (10× no exemplo) se mantém o treino todo. Sem --encoder-lr: um lr só, como na versao1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="790" y="240" width="320" height="100" as="geometry" /></mxCell><mxCell id="L1" value="Época: treino&#10;L = CE + λ · CTC&#10;grad clip 1,0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="200" height="90" as="geometry" /></mxCell><mxCell id="L2" value="val_loss no dev&#10;(só CE, sem o CTC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="440" width="180" height="90" as="geometry" /></mxCell><mxCell id="L3" value="época múltipla de --eval-every?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="430" width="170" height="110" as="geometry" /></mxCell><mxCell id="L4" value="Gera traduções do dev&#10;beam = --eval-beams (4)&#10;BLEU-1..4 · METEOR&#10;→ eval_history.jsonl" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="710" y="440" width="230" height="100" as="geometry" /></mxCell><mxCell id="L5" value="BLEU-4 melhorou mais que --min-delta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="425" width="180" height="120" as="geometry" /></mxCell><mxCell id="best" value="best.pt&#10;(maior BLEU-4 no dev)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="455" width="190" height="60" as="geometry" /></mxCell><mxCell id="L6" value="épocas desde o melhor ≥ --patience?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="610" width="180" height="120" as="geometry" /></mxCell><mxCell id="stop" value="Early stopping&#10;(fim do treino)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="190" height="60" as="geometry" /></mxCell><mxCell id="le1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le3" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le5" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L5" target="best"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le6" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le7" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="L6" target="stop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le8" value="não: próxima época" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9CA3AF;strokeWidth=1;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.6;entryY=1;" edge="1" parent="1" source="L6" target="L1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="670" /></Array></mxGeometry></mxCell><mxCell id="le9" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9CA3AF;strokeWidth=1;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.4;entryY=1;" edge="1" parent="1" source="L3" target="L1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="590" /><mxPoint x="120" y="590" /></Array></mxGeometry></mxCell><mxCell id="le10" value="próxima época" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9CA3AF;strokeWidth=1;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="best" target="L1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="405" /><mxPoint x="140" y="405" /></Array></mxGeometry></mxCell><mxCell id="s1" value="epochN.pt — salvo em toda época" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="260" height="55" as="geometry" /></mxCell><mxCell id="s2" value="best_loss.pt — quando a val_loss melhora (para comparar com o best.pt)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="320" y="790" width="320" height="55" as="geometry" /></mxCell><mxCell id="s2e" value="melhorou?" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9CA3AF;strokeWidth=1;endArrow=blockThin;endFill=1;dashed=1;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="760" /></Array></mxGeometry></mxCell><mxCell id="s3" value="• --patience conta ÉPOCAS desde a melhor avaliação: --eval-every 2 --patience 20 = 10 avaliações seguidas sem melhora.&#10;• --min-delta passa a ser em pontos de BLEU-4.&#10;• Com DDP (torchrun), só o rank 0 gera o BLEU; o valor é replicado (broadcast) e todos os processos decidem igual.&#10;• Sem --select-by (padrão val_loss): best.pt e early stopping pela val_loss, como na versao1." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="670" y="780" width="720" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="dados-v2" name="versao2 — Dados (PHOENIX)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="470" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="SkeLTrans versao2 — Dados do PHOENIX-2014T até o lote" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry" /></mxCell><mxCell id="st" value="tools/phoenix_prepare.py · s3 (MediaPipe) · s4 (normalização) · skeltrans/training/data (Dataset + features extras + collate)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1350" height="20" as="geometry" /></mxCell><mxCell id="dp1" value="PHOENIX-2014-T&#10;frames PNG 210×260 · 25 fps&#10;splits oficiais&#10;7.096 / 519 / 642" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dp2" value="tools/phoenix_prepare.py&#10;frames.json + train/dev/test.json&#10;{features, text (alemão), tokens (glosas)}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="265" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dpe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp1" target="dp2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dp3" value="s3 · MediaPipe Holistic&#10;115 pontos × (X, Y, Z)&#10;ausente = [0, 0, 0]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dpe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp2" target="dp3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dp4" value="s4 · normalização + dinâmica&#10;(T, 115, 9)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dpe3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp3" target="dp4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dp5" value="Dataset&#10;+ extras A,F → (T, 1215)&#10;+ glosas → ids (CTC)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dpe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp4" target="dp5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dp6" value="collate&#10;padding + pad_mask&#10;(B, T, 1215)&#10;→ modelo (aba 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="110" width="195" height="105" as="geometry" /></mxCell><mxCell id="dpe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dp5" target="dp6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dn1" value="Diferença para o V-LIBRASIL: cada vídeo do PHOENIX já é uma frase contínua real, com coarticulação natural. As etapas de síntese (s1a, s1b, s2, s5) não se aplicam. Os splits oficiais mantêm o resultado comparável à literatura." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="640" height="95" as="geometry" /></mxCell><mxCell id="dn2" value="Duração das frases: mediana 110 frames (4,4 s), p95 205, máx. 475.&#10;Com --ds-steps 2: 28 / 52 / 119 posições, bem acima das ~7 glosas por frase (o CTC precisa de T' ≥ nº de glosas)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="260" width="680" height="95" as="geometry" /></mxCell><mxCell id="dn3" value="Qualidade da extração: as mãos (~35 px) são detectadas em ~74% dos frames; em ~10% nenhuma das duas aparece. O grupo F (presença) diz ao modelo quando um 0 significa “mão não detectada”." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="1340" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>