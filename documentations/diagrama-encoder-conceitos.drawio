<mxCell id="spikelab51" value="REGEN&lt;br&gt;frame 51" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#374151;whiteSpace=wrap;fontColor=#9D174D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1117" y="406" width="87" height="30" as="geometry" /></mxCell>
<mxCell id="spike93" value="" style="rounded=0;html=1;fillColor=#DB2777;strokeColor=#DB2777;" vertex="1" parent="1"><mxGeometry x="1451" y="366" width="7" height="38" as="geometry" /></mxCell>
<mxCell id="spikelab93" value="NORD&lt;br&gt;frame 93" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#374151;whiteSpace=wrap;fontColor=#9D174D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1411" y="406" width="87" height="30" as="geometry" /></mxCell>
<mxCell id="rowC_label" value="Modo concept: corta no ponto médio entre disparos → 3 vetores para o T5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="446" width="960" height="22" as="geometry" /></mxCell>
<mxCell id="seg0" value="&lt;b&gt;MORGEN&lt;/b&gt;  (frames 0–30)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="472" width="217" height="34" as="geometry" /></mxCell>
<mxCell id="seg1" value="&lt;b&gt;REGEN&lt;/b&gt;  (frames 31–71)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBF7D0;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1017" y="472" width="287" height="34" as="geometry" /></mxCell>
<mxCell id="seg2" value="&lt;b&gt;NORD&lt;/b&gt;  (frames 72–109)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1304" y="472" width="266" height="34" as="geometry" /></mxCell>
<mxCell id="cutlab31" value="corte 31 = (12+51)/2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#374151;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="957" y="510" width="120" height="18" as="geometry" /></mxCell>
<mxCell id="cutlab72" value="corte 72 = (51+93)/2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=10;fontColor=#374151;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1244" y="510" width="120" height="18" as="geometry" /></mxCell>
<mxCell id="ex_resultado" value="→ O T5 atende a 3 posições (MORGEN, REGEN, NORD) em vez de 28 fatias sem significado, e gera 'morgen regnet es im norden'." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="780" y="536" width="960" height="34" as="geometry" /></mxCell>
<mxCell id="fonte_titulo" value="De onde vêm os disparos? Depende de o modelo conhecer ou não as glosas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="590" width="960" height="26" as="geometry" /></mxCell>
<mxCell id="treino" value="&lt;b&gt;Treino: alinhamento forçado&lt;/b&gt;  (--concept-boundaries align)&lt;br&gt;As glosas verdadeiras da frase são conhecidas. O Viterbi do CTC acha o caminho mais provável que as emite na ordem certa → exatamente 1 disparo por glosa, mesmo no início do treino, quando o CTC ainda só emite blank." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="620" width="470" height="128" as="geometry" /></mxCell>
<mxCell id="inferencia" value="&lt;b&gt;Validação e inferência: greedy&lt;/b&gt;&lt;br&gt;Sem glosas: argmax por frame, colapsa repetições, descarta o blank (a mesma regra do WER). O nº de sinais é o que o modelo detectar. --concept-greedy-prob usa o greedy também numa parte do treino, para os dois mundos ficarem parecidos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=0;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1270" y="620" width="470" height="128" as="geometry" /></mxCell>
<mxCell id="legenda_titulo" value="Legenda" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="768" width="280" height="22" as="geometry" /></mxCell>
<mxCell id="leg0" value="" style="rounded=1;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="780" y="796" width="34" height="22" as="geometry" /></mxCell>
<mxCell id="legt0" value="Dado de entrada" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="796" width="230" height="22" as="geometry" /></mxCell>
<mxCell id="leg1" value="" style="rounded=1;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="780" y="826" width="34" height="22" as="geometry" /></mxCell>
<mxCell id="legt1" value="Etapa de processamento" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="826" width="230" height="22" as="geometry" /></mxCell>
<mxCell id="leg2" value="" style="rounded=1;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="780" y="856" width="34" height="22" as="geometry" /></mxCell>
<mxCell id="legt2" value="Fronteiras dos sinais" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="856" width="230" height="22" as="geometry" /></mxCell>
<mxCell id="leg3" value="" style="rounded=1;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="780" y="886" width="34" height="22" as="geometry" /></mxCell>
<mxCell id="legt3" value="Resultado / saída" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="886" width="230" height="22" as="geometry" /></mxCell>
<mxCell id="leg4" value="" style="rounded=1;html=1;fillColor=#FEF3C7;strokeColor=#DB2777;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="780" y="916" width="34" height="22" as="geometry" /></mxCell>
<mxCell id="legt4" value="Ponto-chave" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="824" y="916" width="230" height="22" as="geometry" /></mxCell>
<mxCell id="glossario" value="&lt;b&gt;Mini-glossário&lt;/b&gt;&lt;br&gt;&lt;b&gt;Glosa:&lt;/b&gt; rótulo escrito de um sinal (MORGEN).&lt;br&gt;&lt;b&gt;CTC:&lt;/b&gt; perda que alinha frames a glosas sem saber onde cada uma está.&lt;br&gt;&lt;b&gt;Viterbi:&lt;/b&gt; busca do caminho mais provável.&lt;br&gt;&lt;b&gt;Pooling:&lt;/b&gt; resumir vários vetores em um.&lt;br&gt;&lt;b&gt;Cross-attention:&lt;/b&gt; como o decoder 'olha' a memória do encoder." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="952" width="300" height="160" as="geometry" /></mxCell>
<mxCell id="levar" value="&lt;b&gt;O que levar daqui&lt;/b&gt;&lt;br&gt;&lt;br&gt;• O modo concept só muda o eixo do TEMPO. A projeção espacial (flat/parts/gcn) e as features de entrada continuam as mesmas.&lt;br&gt;&lt;br&gt;• O CTC ganha um segundo papel: além de supervisionar, ele diz onde cada sinal está. Por isso o modo exige --use-ctc com --ctc-weight &amp;gt; 0.&lt;br&gt;&lt;br&gt;• Erro comum: achar que o pooling é a média dos keypoints. Ele agrupa frames JÁ contextualizados pelo Transformer, com pesos aprendidos.&lt;br&gt;&lt;br&gt;• Onde isso aparece: no PHOENIX as fronteiras vêm do alinhamento do CTC; no Libras sintético poderão vir da própria montagem das frases (fronteiras perfeitas)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="1100" y="768" width="640" height="344" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>