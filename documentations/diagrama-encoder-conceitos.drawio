<mxCell id="rowB_label" value="CTC sobre o Transformer de frames: dispara 1–2 frames por sinal, blank (_) no resto" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="344" width="960" height="22" as="geometry" /></mxCell>
