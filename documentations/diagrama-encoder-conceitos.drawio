<mxfile host="app.diagrams.net" agent="Claude" type="device"><diagram id="encoder-conceitos" name="Encoder por conceitos"><mxGraphModel dx="1780" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="Encoder por conceitos (--temporal-mode concept): uma posição por SINAL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="34" as="geometry" /></mxCell>
<mxCell id="subtitulo" value="Fio condutor: em vez de cortar o vídeo a cada 4 frames às cegas, cortar onde um sinal termina — o decoder T5 recebe uma sequência de sinais, parecida com a sequência de palavras do seu pré-treino." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1620" height="30" as="geometry" /></mxCell>
<mxCell id="etapa1" value="Keypoints de cada frame" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="108" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota1" value="115 pontos × (posição, velocidade, aceleração) + extras A–F = 1242 números por frame. Um vídeo é uma pilha de frames: (1, 110, 1242)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="112" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig1" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa1" target="nota1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa2" value="Projeção espacial&lt;br&gt;flat | parts | gcn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="236" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="224" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota2" value="Junta os pontos de UM frame num vetor de 512. Igual ao modo stride: o modo concept só mexe no eixo do TEMPO, não no do espaço." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="228" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig2" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa2" target="nota2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa3" value="Conv temporal&lt;br&gt;(+ ds-steps opcional)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="352" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="340" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota3" value="Suaviza vizinhos no tempo. O ds-steps ainda pode encurtar um pouco (ex.: 1 = metade); no exemplo usamos 0 e os 110 frames seguem inteiros." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="344" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig3" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa3" target="nota3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa4" value="Transformer de FRAMES" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="468" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="456" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota4" value="Cada frame passa a 'saber' o contexto ao redor (--num-layers). Ainda é uma posição por frame: 110 vetores." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="460" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig4" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa4" target="nota4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa5" value="Head CTC: onde está&lt;br&gt;cada sinal?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="120" y="584" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="572" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota5" value="O CTC é 'pontudo': dispara em 1–2 frames por sinal e emite blank no resto. Cada disparo marca um sinal. Além de supervisionar, o CTC agora diz ONDE os sinais estão." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="576" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig5" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa5" target="nota5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa6" value="Cortar no meio&lt;br&gt;entre disparos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeColor=#DB2777;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="120" y="700" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="688" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota6" value="O ponto-chave. Corte no ponto médio entre dois disparos: todo frame pertence a algum sinal. (12+51)/2 = 31 e (51+93)/2 = 72. Frase sem disparo vira 1 sinal, nunca 0." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="692" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig6" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa6" target="nota6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa7" value="Pooling por sinal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="816" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="804" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota7" value="Os frames de cada sinal viram 1 vetor por média PONDERADA: o pico do movimento pesa mais que a transição. Com --concept-queries K, cada sinal vira K vetores." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="808" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig7" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa7" target="nota7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa8" value="Transformer de CONCEITOS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="120" y="932" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="920" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota8" value="Os sinais se 'enxergam' entre si (--concept-layers). Agora 1 posição = 1 sinal: 3 vetores em vez de 110." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="924" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig8" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa8" target="nota8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="etapa9" value="Decoder T5 gera a frase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fontSize=13;fontStyle=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="120" y="1048" width="240" height="58" as="geometry" /></mxCell>
<mxCell id="num9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F2937;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="108" y="1036" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="nota9" value="Cross-attention sobre 3 posições: 'morgen regnet es im norden'. É o regime do pré-treino do T5, em que 1 posição ≈ 1 unidade de significado." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="1040" width="330" height="90" as="geometry" /></mxCell>
<mxCell id="lig9" value="" style="endArrow=none;dashed=1;strokeColor=#FCD34D;html=1;" edge="1" parent="1" source="etapa9" target="nota9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="seta1-2" value="(1, 110, 1242)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa1" target="etapa2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
