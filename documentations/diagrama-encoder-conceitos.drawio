<mxCell id="seta3-4" value="(1, 110, 512)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa3" target="etapa4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="seta4-5" value="(1, 110, 512)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa4" target="etapa5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="seta5-6" value="disparos: 12 · 51 · 93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa5" target="etapa6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="seta6-7" value="sinais: 0–30 · 31–71 · 72–109" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa6" target="etapa7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
