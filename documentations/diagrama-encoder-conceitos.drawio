<mxCell id="seta8-9" value="(1, 3, 768)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="etapa8" target="etapa9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="seta4-7" value="frames&lt;br&gt;contextualizados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="etapa4" target="etapa7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="62" y="497.0" /><mxPoint x="62" y="845.0" /></Array></mxGeometry></mxCell>
<mxCell id="analogia" value="&lt;b&gt;Analogia: um texto escrito sem espaços&lt;/b&gt;&lt;br&gt;OAMANHÃVAICHOVERNONORTE&lt;br&gt;• &lt;b&gt;stride&lt;/b&gt; corta de 2 em 2 letras: OA | MA | NH | ÃV | AI | CH | OV | ER | … → pedaços sem significado; o leitor (T5) que remonte as palavras.&lt;br&gt;• &lt;b&gt;concept&lt;/b&gt; corta nos espaços: O | AMANHÃ | VAI | CHOVER | NO | NORTE → 1 pedaço = 1 palavra = 1 sinal." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#111827;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="112" width="960" height="112" as="geometry" /></mxCell>
<mxCell id="ex_titulo" value="Exemplo: uma frase do PHOENIX — 110 frames, glosas MORGEN · REGEN · NORD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;fontSize=14;" vertex="1" parent="1"><mxGeometry x="780" y="240" width="960" height="26" as="geometry" /></mxCell>
<mxCell id="rowA_label" value="Modo stride (hoje): fatias de 4 frames, sem olhar o sinal → 28 vetores para o T5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F2937;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="780" y="272" width="960" height="22" as="geometry" /></mxCell>
