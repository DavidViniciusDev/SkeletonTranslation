<mxfile host="app.diagrams.net" agent="Claude" type="device"><diagram id="visao" name="1 · Visão geral"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Jornada de uma frase pelo SkeLTrans (versao1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry" /></mxCell><mxCell id="st" value="Exemplo: “Amanhã eu vou para casa.” — números de frames ilustrativos; formatos e regras conforme o código" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1000" height="20" as="geometry" /></mxCell><mxCell id="gdados" value="Pipeline de dados (aba 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#D1D5DB;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#6B7280;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="900" height="300" as="geometry" /></mxCell><mxCell id="gmod" value="Modelo SLT (aba 3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FAFAFA;strokeColor=#D1D5DB;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#6B7280;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="940" y="95" width="550" height="300" as="geometry" /></mxCell><mxCell id="v1" value="1 · Frase em português" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v1d" value="“Amanhã eu vou para casa.”" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="v2" value="2 · Glosas em Libras" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v2d" value="AMANHÃ EU IR CASA [PONTO]&#10;→ 4 sinais" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="230" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3" value="3 · Vídeos dos sinais" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v3d" value="4 vídeos isolados, mesmo intérprete&#10;45 + 30 + 40 + 50 frames" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="410" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v4" value="4 · Keypoints (MediaPipe)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v4d" value="115 pontos × (X,Y,Z)&#10;por frame, por sinal" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="590" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v5" value="5 · Frase sintética" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v5d" value="colagem + 3 transições de 5 frames + normalização&#10;180 × 115 × 9" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="770" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v6" value="6 · LandmarkEncoder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v6d" value="180 × 1035&#10;→ 45 × 768&#10;(memory)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="7 · Decoder PTT5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v7d" value="lê a memory por cross-attention e escreve em PT" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1140" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="8 · Tradução" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="150" height="70" as="geometry" /></mxCell><mxCell id="v8d" value="“Amanhã eu vou para casa.”" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1320" y="220" width="150" height="80" as="geometry" /></mxCell><mxCell id="va7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vkey" value="a frase original é o ALVO do treino (labels)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;fontSize=12;fontColor=#14532D;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="v1" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="85" /><mxPoint x="1395" y="85" /></Array></mxGeometry></mxCell><mxCell id="videia" value="A ideia em uma frase: não existe vídeo de Libras contínua suficiente, então o projeto MONTA frases a partir de sinais isolados (etapas 2–5) e treina o modelo para fazer o caminho de volta — dos keypoints da frase montada até o texto original (etapas 6–8)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1440" height="60" as="geometry" /></mxCell><mxCell id="lg" value="Legenda de cores" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="300" height="20" as="geometry" /></mxCell><mxCell id="lg1" value="Dado de entrada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="150" height="36" as="geometry" /></mxCell><mxCell id="lg2" value="Processamento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="150" height="36" as="geometry" /></mxCell><mxCell id="lg3" value="Ponto-chave da pesquisa / exemplo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="440" width="210" height="36" as="geometry" /></mxCell><mxCell id="lg4" value="Componente pré-treinado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="440" width="180" height="36" as="geometry" /></mxCell><mxCell id="lg5" value="Resultado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="440" width="120" height="36" as="geometry" /></mxCell><mxCell id="lg6" value="Arquivo / tensor" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="900" y="440" width="140" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="dados" name="2 · Dados: frase → keypoints"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Aba 2 · Da frase em português à frase sintética de keypoints" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry" /></mxCell><mxCell id="st" value="Pipeline de dados (skeltrans/extraction/steps) aplicado a “Amanhã eu vou para casa.”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="20" as="geometry" /></mxCell><mxCell id="hd1" value="ETAPA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="230" height="20" as="geometry" /></mxCell><mxCell id="hd2" value="O QUE ACONTECE COM O EXEMPLO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="760" height="20" as="geometry" /></mxCell><mxCell id="hd3" value="POR QUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="300" height="20" as="geometry" /></mxCell><mxCell id="sAB" value="A–B · Frase → glosas&#10;&#10;texto → 4 sinais" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="170" as="geometry" /></mxCell><mxCell id="sAB_pq" value="Por que existe&#10;Só entram frases 100% cobertas pelo vocabulário de vídeos (~1.300 sinais): sem vídeo de um sinal, não há como montar a frase.&#10;127 mil frases do corpus → 3.019 após o filtro e a expansão de &amp;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="300" height="170" as="geometry" /></mxCell><mxCell id="ab1" value="“Amanhã eu vou para casa.”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="250" height="45" as="geometry" /></mxCell><mxCell id="ab2" value="AMANHÃ EU IR CASA [PONTO]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="110" width="300" height="45" as="geometry" /></mxCell><mxCell id="abe1" value="glosa do corpus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ab1" target="ab2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="abc" value="Normaliza (MAIÚSCULAS, sem acento) e confere cada sinal no vocabulário de vídeos:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="760" height="20" as="geometry" /></mxCell><mxCell id="abt0" value="AMANHA ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="140" height="45" as="geometry" /></mxCell><mxCell id="abt1" value="EU ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="452" y="200" width="140" height="45" as="geometry" /></mxCell><mxCell id="abt2" value="IR ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="604" y="200" width="140" height="45" as="geometry" /></mxCell><mxCell id="abt3" value="CASA ✓" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="756" y="200" width="140" height="45" as="geometry" /></mxCell><mxCell id="abt4" value="[PONTO]&#10;ignorado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="908" y="200" width="140" height="45" as="geometry" /></mxCell><mxCell id="abc2" value="Repare: a glosa não segue a ordem do português (“vou para”) — em Libras é AMANHÃ EU IR CASA. Por isso o modelo precisa TRADUZIR, e não só transcrever." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="760" height="20" as="geometry" /></mxCell><mxCell id="sC" value="C · Glosas → vídeos&#10;&#10;4 arquivos .mp4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="160" as="geometry" /></mxCell><mxCell id="sC_pq" value="Por que existe&#10;Misturar intérpretes ou augmentations criaria saltos de corpo e escala no meio da frase — um artefato que o modelo aprenderia a explorar." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="300" width="300" height="160" as="geometry" /></mxCell><mxCell id="cv0" value="1-AMANHA.mp4&#10;45 frames" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="300" y="315" width="170" height="55" as="geometry" /></mxCell><mxCell id="cv1" value="1-EU.mp4&#10;30 frames" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="490" y="315" width="170" height="55" as="geometry" /></mxCell><mxCell id="cv2" value="1-IR.mp4&#10;40 frames" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="680" y="315" width="170" height="55" as="geometry" /></mxCell><mxCell id="cv3" value="1-CASA.mp4&#10;50 frames" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="870" y="315" width="170" height="55" as="geometry" /></mxCell><mxCell id="cc" value="Regra de consistência: todos os vídeos da frase vêm do MESMO intérprete e da MESMA augmentation (aqui: intérprete 1, sem augmentation). O intérprete 0 sem augmentation (a “base”) fica reservado para o teste." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="385" width="760" height="50" as="geometry" /></mxCell><mxCell id="sD" value="D · Vídeo → keypoints&#10;(MediaPipe Holistic)&#10;&#10;por sinal: T × 115 × 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="230" height="250" as="geometry" /></mxCell><mxCell id="sD_pq" value="Por que existe&#10;x e y vêm como fração da imagem (0 a 1); z é profundidade relativa.&#10;Ponto não detectado vira [0,0,0]: o zero passa a significar “ausente”.&#10;Rosto: só 40 dos 468 pontos do FaceMesh — lábios, olhos e sobrancelhas, as expressões não manuais." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="490" width="300" height="250" as="geometry" /></mxCell><mxCell id="dc" value="Os 115 pontos de cada frame, sempre nesta ordem (common/layout.py):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="495" width="760" height="20" as="geometry" /></mxCell><mxCell id="dp1" value="Pose · 33&#10;[0:33)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="165" height="45" as="geometry" /></mxCell><mxCell id="dp2" value="Mão esq. · 21&#10;[33:54)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="465" y="520" width="105" height="45" as="geometry" /></mxCell><mxCell id="dp3" value="Mão dir. · 21&#10;[54:75)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="105" height="45" as="geometry" /></mxCell><mxCell id="dp4" value="Face · 40&#10;[75:115)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="520" width="200" height="45" as="geometry" /></mxCell><mxCell id="dpx" value="1 ponto = 5 px" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="885" y="532" width="120" height="20" as="geometry" /></mxCell><mxCell id="dm" value="Frame 20 de 1-IR.mp4 (valores ilustrativos):&#10;pose 11 · ombro      x=0,60  y=0,50  z=-0,05&#10;pose 12 · ombro      x=0,40  y=0,50  z=-0,05&#10;pose 16 · pulso      x=0,38  y=0,41  z=-0,12&#10;mão esq. (21 pts)    [0, 0, 0]  &lt;- não detectada&#10;... 115 pontos × 3 números" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="580" width="470" height="140" as="geometry" /></mxCell><mxCell id="dout" value="landmarks_115/*.npy&#10;1-AMANHA: 45 × 115 × 3&#10;1-EU: 30 × 115 × 3&#10;1-IR: 40 × 115 × 3&#10;1-CASA: 50 × 115 × 3" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="800" y="580" width="260" height="140" as="geometry" /></mxCell><mxCell id="de1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="dm" target="dout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sF" value="F · Colagem + transições&#10;(Keyframe Blending)&#10;&#10;4 sinais → 1 frase de 180 frames" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="230" height="290" as="geometry" /></mxCell><mxCell id="sF_pq" value="Por que existe&#10;Sinais isolados começam e terminam em repouso; colados “a seco”, a mão se teletransportaria entre um sinal e outro.&#10;A transição cria o movimento de ligação (coarticulação) da sinalização contínua.&#10;Ablação: --interp-mode none (seca) ou cubic." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="770" width="300" height="290" as="geometry" /></mxCell><mxCell id="fc" value="Linha do tempo da frase (1 frame = 4 px):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="775" width="760" height="20" as="geometry" /></mxCell><mxCell id="f1" value="AMANHÃ · 45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="180" height="40" as="geometry" /></mxCell><mxCell id="f2" value="T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="800" width="20" height="40" as="geometry" /></mxCell><mxCell id="f3" value="EU · 30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="800" width="120" height="40" as="geometry" /></mxCell><mxCell id="f4" value="T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="800" width="20" height="40" as="geometry" /></mxCell><mxCell id="f5" value="IR · 40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="800" width="160" height="40" as="geometry" /></mxCell><mxCell id="f6" value="T" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="800" width="20" height="40" as="geometry" /></mxCell><mxCell id="f7" value="CASA · 50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="800" width="200" height="40" as="geometry" /></mxCell><mxCell id="fc2" value="frames: AMANHÃ 0–44 · T 45–49 · EU 50–79 · T 80–84 · IR 85–124 · T 125–129 · CASA 130–179  →  180 frames (6 s a 30 fps)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="845" width="760" height="20" as="geometry" /></mxCell><mxCell id="fc3" value="Zoom na transição AMANHÃ → EU (interpolação linear, K = 5), coordenada y do pulso: α = 1/6 … 5/6" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="880" width="760" height="20" as="geometry" /></mxCell><mxCell id="fl0" value="0,30&#10;fim AMANHÃ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl1" value="0,342" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="403" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl2" value="0,383" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="506" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl3" value="0,425" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="609" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl4" value="0,467" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="712" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl5" value="0,508" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;" vertex="1" parent="1"><mxGeometry x="815" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fl6" value="0,55&#10;início EU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="918" y="905" width="95" height="45" as="geometry" /></mxCell><mxCell id="fc4" value="valor = (1 − α)·0,30 + α·0,55. Um ponto só é interpolado se existir dos dois lados; senão continua [0,0,0]." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="960" width="760" height="40" as="geometry" /></mxCell><mxCell id="sE" value="E · Normalização&#10;(sobre a frase já colada)&#10;&#10;180 × 115 × 3 → 180 × 115 × 9" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="230" height="280" as="geometry" /></mxCell><mxCell id="sE_pq" value="Por que existe&#10;Centralizar e escalar tornam o esqueleto independente de onde a pessoa está no quadro e da distância até a câmera.&#10;Normalizar DEPOIS de colar faz velocidade e aceleração atravessarem as transições corretamente.&#10;Velocidade e aceleração entregam o movimento pronto para o modelo." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1090" width="300" height="280" as="geometry" /></mxCell><mxCell id="e1" value="1. Centralizar&#10;origem = meio dos ombros&#10;= (0,50 ; 0,50)&#10;pulso: (0,38−0,50 ; 0,41−0,50)&#10;     = (−0,12 ; −0,09)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="1100" width="240" height="120" as="geometry" /></mxCell><mxCell id="e2" value="2. Escalar&#10;÷ distância entre ombros&#10;= 0,60 − 0,40 = 0,20&#10;pulso: (−0,12 ; −0,09) ÷ 0,20&#10;     = (−0,60 ; −0,45)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="240" height="120" as="geometry" /></mxCell><mxCell id="e3" value="3. Dinâmica&#10;V = P(t) − P(t−1)&#10;A = V(t) − V(t−1)&#10;P(t−1) = (−0,65 ; −0,40)&#10;V = (0,05 ; −0,05)&#10;V(t−1) = (0,04 ; −0,03)&#10;A = (0,01 ; −0,02)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="1100" width="240" height="125" as="geometry" /></mxCell><mxCell id="ee1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ee2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="eout" value="sentence_features/‹id›.npy  ·  180 × 115 × 9  —  por ponto: X, Y, Z (posição) · Vx, Vy, Vz (velocidade) · Ax, Ay, Az (aceleração)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="300" y="1240" width="760" height="50" as="geometry" /></mxCell><mxCell id="next" value="Segue para o modelo → aba 3" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="230" height="45" as="geometry" /></mxCell><mxCell id="nsAB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sAB" target="sC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nsC" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sC" target="sD"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nsD" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sD" target="sF"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nsF" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sF" target="sE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nsE" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sE" target="next"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ordem" value="Obs.: no código, a etapa E (normalize_landmarks) também existe por sinal isolado, mas build_sentence_features lê os landmarks crus e aplica a normalização na frase colada (feature_mode=normalized, padrão) — a ordem mostrada aqui." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="760" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="modelo" name="3 · Modelo: encoder etapa a etapa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="Aba 3 · O que o LandmarkEncoder faz com a frase AMANHÃ EU IR CASA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry" /></mxCell><mxCell id="st" value="skeltrans/training/models/landmark_encoder.py · ds_steps = 2 · d_model = 512 · 6 camadas · 8 cabeças · lote com uma frase de 600 frames" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="20" as="geometry" /></mxCell><mxCell id="hd1" value="ETAPA E FORMATO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="230" height="20" as="geometry" /></mxCell><mxCell id="hd2" value="O QUE ACONTECE COM O EXEMPLO" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="760" height="20" as="geometry" /></mxCell><mxCell id="hd3" value="POR QUE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="1090" y="75" width="300" height="20" as="geometry" /></mxCell><mxCell id="m0" value="0 · Flatten + lote&#10;&#10;180×115×9 → 180×1035" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="210" as="geometry" /></mxCell><mxCell id="m0_pq" value="Por que existe&#10;O modelo só entende uma lista de números por instante.&#10;O lote precisa ser retangular: frases curtas são completadas com frames falsos e a MÁSCARA marca quais ignorar. Ela acompanha a frase até o decoder." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="100" width="300" height="210" as="geometry" /></mxCell><mxCell id="m0a" value="1 frame&#10;115 pontos × 9 canais&#10;(tabela)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="160" height="70" as="geometry" /></mxCell><mxCell id="m0b0" value="ponto 0 · 9 nº" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="500" y="125" width="100" height="40" as="geometry" /></mxCell><mxCell id="m0b1" value="ponto 1 · 9 nº" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="125" width="100" height="40" as="geometry" /></mxCell><mxCell id="m0b2" value="ponto 2 · 9 nº" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="125" width="100" height="40" as="geometry" /></mxCell><mxCell id="m0b3" value="…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="125" width="100" height="40" as="geometry" /></mxCell><mxCell id="m0b4" value="ponto 114 · 9 nº" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="125" width="100" height="40" as="geometry" /></mxCell><mxCell id="m0e" value="enfileira" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m0a" target="m0b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m0c" value="1 linha de 1035 números por frame (dataset.py: reshape). Nada é calculado, só reorganizado." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="560" height="20" as="geometry" /></mxCell><mxCell id="m0d" value="Lote (8 frases) — 1 px = 1 frame:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="205" width="300" height="20" as="geometry" /></mxCell><mxCell id="m0r" value="nossa frase · 180 reais" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="180" height="26" as="geometry" /></mxCell><mxCell id="m0p" value="420 de padding · máscara = True (ignorar)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="420" height="26" as="geometry" /></mxCell><mxCell id="m0l" value="outra frase do lote · 600 reais" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="262" width="600" height="26" as="geometry" /></mxCell><mxCell id="m1" value="1 · Linear 1035 → 512&#10;&#10;180×1035 → 180×512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="230" height="170" as="geometry" /></mxCell><mxCell id="m1_pq" value="Por que existe&#10;Números crus (“x do ponto 58”) quase não significam nada; combinações deles sim.&#10;512 é a largura de trabalho (d_model) do encoder." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="340" width="300" height="170" as="geometry" /></mxCell><mxCell id="m1a" value="Exemplo de bolso: 3 entradas → 2 saídas&#10;entradas: mão dir. 0,8 · queixo 0,7 · boca 0,1&#10;&#10;s0 = 1,0·0,8 − 1,0·0,7 + 0·0,1 = 0,1&#10;     -&gt; 'mão na altura do queixo'&#10;s1 = 5,0·0,1 = 0,5  -&gt; 'boca aberta'" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="470" height="140" as="geometry" /></mxCell><mxCell id="m1b" value="Na rede real:&#10;• 512 somas ponderadas das 1035 entradas&#10;• mesmos pesos nos 180 frames&#10;• cada frame ainda é visto SOZINHO&#10;• 530.432 parâmetros aprendidos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="800" y="350" width="260" height="140" as="geometry" /></mxCell><mxCell id="m2" value="2 · Conv1D temporal k=3&#10;&#10;180×512 → 180×512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="230" height="210" as="geometry" /></mxCell><mxCell id="m2_pq" value="Por que existe&#10;Um sinal é movimento, e movimento só aparece comparando frames vizinhos.&#10;512 filtros aprendidos, cada um procura um padrão local diferente." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="300" height="210" as="geometry" /></mxCell><mxCell id="m2c" value="Janela de 3 frames desliza de 1 em 1 (zeros nas pontas):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="545" width="500" height="20" as="geometry" /></mxCell><mxCell id="m2i0" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i1" value="f0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="356" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i2" value="f1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="412" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i3" value="f2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i4" value="f3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="524" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i5" value="f4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i6" value="f5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i7" value="f6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="692" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2i8" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="748" y="570" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o1" value="s0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="356" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o2" value="s1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="412" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o3" value="s2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="468" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o4" value="s3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="524" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o5" value="s4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o6" value="s5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o7" value="s6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="692" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2o8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;dashed=1;fontColor=#6B7280;fontSize=10;" vertex="1" parent="1"><mxGeometry x="748" y="640" width="50" height="34" as="geometry" /></mxCell><mxCell id="m2e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="m2i2" target="m2o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m2c2" value="f1, f2, f3 → s2 · 1 saída por frame: T continua 180" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="685" width="500" height="20" as="geometry" /></mxCell><mxCell id="m2m" value="Filtro detector de movimento&#10;pesos [−1, 0, +1]&#10;&#10;altura: 0  0  1  3  6  6  6&#10;saída:  0  1  3  5  3  0 −6&#10;&#10;−6 = efeito de borda do padding&#10;(a mão estava parada)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="545" width="240" height="170" as="geometry" /></mxCell><mxCell id="m3" value="3 · Downsampling ×2&#10;(Conv1D k=5, stride 2 + GELU)&#10;&#10;180 → 90 → 45 posições" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="230" height="300" as="geometry" /></mxCell><mxCell id="m3_pq" value="Por que existe&#10;Frames vizinhos a 30 fps são quase iguais.&#10;Encurtar 4× corta o custo da atenção em 16× (180² → 45²) e deixa ~45 posições para ~6 palavras, perto do regime de pré-treino do T5.&#10;GELU: sem ela, duas convs equivaleriam a uma só." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="780" width="300" height="300" as="geometry" /></mxCell><mxCell id="m3a0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a1" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="345" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a2" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="390" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a3" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="435" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a4" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a5" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a6" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a7" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="615" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a8" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="660" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a9" value="10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="705" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a10" value="11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="750" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a11" value="12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="795" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a12" value="13" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="840" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a13" value="14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="885" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a14" value="15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3a15" value="16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="975" y="790" width="42" height="30" as="geometry" /></mxCell><mxCell id="m3b0" value="a" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b1" value="b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b2" value="c" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b3" value="d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b4" value="e" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b5" value="f" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="750" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b6" value="g" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3b7" value="h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#1E3A8A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="826" width="87" height="30" as="geometry" /></mxCell><mxCell id="m3c0" value="A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="862" width="177" height="30" as="geometry" /></mxCell><mxCell id="m3c1" value="B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="862" width="177" height="30" as="geometry" /></mxCell><mxCell id="m3c2" value="C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="862" width="177" height="30" as="geometry" /></mxCell><mxCell id="m3c3" value="D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="862" width="177" height="30" as="geometry" /></mxCell><mxCell id="m3l1" value="16 frames" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1025" y="795" width="60" height="20" as="geometry" /></mxCell><mxCell id="m3l2" value="8 (÷2)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1025" y="831" width="60" height="20" as="geometry" /></mxCell><mxCell id="m3l3" value="4 (÷2)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="1025" y="867" width="60" height="20" as="geometry" /></mxCell><mxCell id="m3cap" value="Cada posição final ocupa o lugar de 4 frames e “enxerga” 15 (≈ 0,5 s), com janelas sobrepostas. Ninguém é descartado sem ser resumido." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="760" height="20" as="geometry" /></mxCell><mxCell id="m3cap2" value="Nossa frase depois do downsampling (1 posição = 16 px):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="930" width="760" height="20" as="geometry" /></mxCell><mxCell id="m3s1" value="AMANHÃ · pos 0–11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="955" width="192" height="34" as="geometry" /></mxCell><mxCell id="m3s2" value="EU · 12–20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="492" y="955" width="144" height="34" as="geometry" /></mxCell><mxCell id="m3s3" value="IR · 21–31" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="636" y="955" width="176" height="34" as="geometry" /></mxCell><mxCell id="m3s4" value="CASA · 32–44" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="812" y="955" width="208" height="34" as="geometry" /></mxCell><mxCell id="m3m" value="Máscara recalculada: 180 → 90 → 45 válidas (e 600 → 150 na frase longa: nossas posições 45–149 viram padding). As transições ficam “dissolvidas” nas bordas dos sinais." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="995" width="760" height="40" as="geometry" /></mxCell><mxCell id="m4" value="4 · LayerNorm&#10;&#10;45×512 → 45×512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="230" height="160" as="geometry" /></mxCell><mxCell id="m4_pq" value="Por que existe&#10;Nivela a escala de cada vetor antes da atenção, que é sensível a valores grandes.&#10;É por vetor (e não por lote) para que o padding não entre na conta." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1110" width="300" height="160" as="geometry" /></mxCell><mxCell id="m4c" value="Exemplo com um vetor de 4 números:" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1115" width="400" height="20" as="geometry" /></mxCell><mxCell id="m4a0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="1140" width="60" height="36" as="geometry" /></mxCell><mxCell id="m4a1" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="364" y="1140" width="60" height="36" as="geometry" /></mxCell><mxCell id="m4a2" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="428" y="1140" width="60" height="36" as="geometry" /></mxCell><mxCell id="m4a3" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="492" y="1140" width="60" height="36" as="geometry" /></mxCell><mxCell id="m4b0" value="−1,34" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="1140" width="70" height="36" as="geometry" /></mxCell><mxCell id="m4b1" value="−0,45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="694" y="1140" width="70" height="36" as="geometry" /></mxCell><mxCell id="m4b2" value="0,45" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="768" y="1140" width="70" height="36" as="geometry" /></mxCell><mxCell id="m4b3" value="1,34" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#0B1F3A;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="842" y="1140" width="70" height="36" as="geometry" /></mxCell><mxCell id="m4e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4a3" target="m4b0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m4c2" value="Média 5, desvio 2,24. Subtrai a média e divide pelo desvio → média 0, variância 1. A “forma” do vetor é mantida. Depois multiplica por γ e soma β (1.024 parâmetros aprendidos)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1190" width="760" height="40" as="geometry" /></mxCell><mxCell id="m5" value="5 · Positional Encoding&#10;+ Dropout 0,2&#10;&#10;45×512 → 45×512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="230" height="220" as="geometry" /></mxCell><mxCell id="m5_pq" value="Por que existe&#10;A atenção trata as posições como um conjunto: sem PE, “AMANHÃ EU IR CASA” e “CASA IR EU AMANHÃ” seriam iguais para ela.&#10;Dropout impede o modelo de decorar artefatos da síntese." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1300" width="300" height="220" as="geometry" /></mxCell><mxCell id="m5a" value="PE: soma um padrão fixo de senos/cossenos&#10;&#10;posição          0     1     2     3     4&#10;dim 0  sen(p)    0  0,84  0,91  0,14 -0,76  &lt;- ponteiro rápido&#10;dim 256 sen(p/100)&#10;                 0  0,01  0,02  0,03  0,04  &lt;- ponteiro lento&#10;&#10;Como um relógio: juntos, os 256 pares de&#10;ponteiros identificam cada posição." style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="1310" width="490" height="165" as="geometry" /></mxCell><mxCell id="m5b" value="Dropout (só no treino)&#10;&#10;antes:  1     2  3     4  5&#10;sorteio ok    x  ok   ok  x&#10;depois: 1,25  0  3,75  5  0&#10;&#10;20% zerados; os outros × 1,25&#10;(na inferência: desligado)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=4;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#111827;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="810" y="1310" width="250" height="165" as="geometry" /></mxCell><mxCell id="m5c" value="Atenção: o PE vem depois do downsampling — a posição 10 aqui é o trecho perto do frame 40, dentro do sinal AMANHÃ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1485" width="760" height="20" as="geometry" /></mxCell><mxCell id="m6" value="6 · Transformer × 6&#10;(self-attention 8 cabeças&#10;+ feed-forward 2048)&#10;&#10;45×512 → 45×512" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1550" width="230" height="330" as="geometry" /></mxCell><mxCell id="m6_pq" value="Por que existe&#10;Até aqui cada posição só via ~15 frames.&#10;A atenção liga qualquer trecho a qualquer outro: o verbo IR fica sabendo do destino (CASA) e do tempo (AMANHÃ).&#10;É onde estão 81% dos parâmetros do encoder (18,9 M)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1550" width="300" height="330" as="geometry" /></mxCell><mxCell id="m6c" value="Quanto cada região presta atenção às outras (valores ilustrativos; cada linha soma 1):" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1555" width="760" height="20" as="geometry" /></mxCell><mxCell id="m6h0" value="AMANHÃ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="385" y="1580" width="72" height="24" as="geometry" /></mxCell><mxCell id="m6h1" value="EU" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="459" y="1580" width="72" height="24" as="geometry" /></mxCell><mxCell id="m6h2" value="IR" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="533" y="1580" width="72" height="24" as="geometry" /></mxCell><mxCell id="m6h3" value="CASA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="607" y="1580" width="72" height="24" as="geometry" /></mxCell><mxCell id="m6hp" value="padding" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="681" y="1580" width="72" height="24" as="geometry" /></mxCell><mxCell id="m6r0" value="AMANHÃ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="1608" width="80" height="34" as="geometry" /></mxCell><mxCell id="m6c00" value="0,55" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="385" y="1608" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c01" value="0,10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="459" y="1608" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c02" value="0,25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="533" y="1608" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c03" value="0,10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="607" y="1608" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6p0" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="681" y="1608" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6r1" value="EU" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="1646" width="80" height="34" as="geometry" /></mxCell><mxCell id="m6c10" value="0,10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="1646" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c11" value="0,60" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="459" y="1646" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c12" value="0,25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="533" y="1646" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c13" value="0,05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="607" y="1646" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6p1" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="681" y="1646" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6r2" value="IR" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="1684" width="80" height="34" as="geometry" /></mxCell><mxCell id="m6c20" value="0,20" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#93C5FD;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="1684" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c21" value="0,15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#FFFFFF;fontColor=#1E3A8A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="459" y="1684" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c22" value="0,35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="533" y="1684" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c23" value="0,30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="607" y="1684" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6p2" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="681" y="1684" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6r3" value="CASA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="300" y="1722" width="80" height="34" as="geometry" /></mxCell><mxCell id="m6c30" value="0,05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="385" y="1722" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c31" value="0,05" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="459" y="1722" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c32" value="0,40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3B82F6;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="533" y="1722" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6c33" value="0,50" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="607" y="1722" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6p3" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1"><mxGeometry x="681" y="1722" width="72" height="34" as="geometry" /></mxCell><mxCell id="m6x" value="Em cada uma das 6 camadas:&#10;1. Self-attention: cada posição compara sua Query com a Key de todas (÷ √64), aplica softmax e faz a média ponderada dos Values&#10;2. soma residual + LayerNorm&#10;3. Feed-forward 512 → 2048 → 512 (cada posição sozinha)&#10;4. soma residual + LayerNorm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="780" y="1580" width="280" height="180" as="geometry" /></mxCell><mxCell id="m6r" value="Leitura: a linha IR dá 30% da atenção a CASA (o destino) e 20% a AMANHÃ (o tempo). Padding sempre recebe 0 — a máscara vira −∞ antes da softmax." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="1770" width="760" height="40" as="geometry" /></mxCell><mxCell id="m7" value="7 · Adapter Linear 512 → 768&#10;&#10;45×512 → 45×768" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1910" width="230" height="150" as="geometry" /></mxCell><mxCell id="m7_pq" value="Por que existe&#10;Adaptador de tomada: o decoder PTT5-base foi pré-treinado com vetores de 768.&#10;393.984 parâmetros que aprendem a pôr a informação onde a cross-attention do T5 sabe ler." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="1910" width="300" height="150" as="geometry" /></mxCell><mxCell id="m7a" value="45 × 512" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="1940" width="150" height="50" as="geometry" /></mxCell><mxCell id="m7b" value="Linear 512 → 768&#10;(cada posição)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="1940" width="180" height="50" as="geometry" /></mxCell><mxCell id="m7c" value="memory · 45 × 768&#10;+ máscara (45 válidas)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="770" y="1930" width="290" height="70" as="geometry" /></mxCell><mxCell id="m7e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m7a" target="m7b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m7e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=1;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m7b" target="m7c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m7d" value="Saída final do encoder: 45 vetores, cada um resumindo ~0,5 s da frase com o contexto da frase inteira." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="2010" width="760" height="30" as="geometry" /></mxCell><mxCell id="m8" value="Decoder PTT5 (resumo)&#10;&#10;memory → texto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2100" width="230" height="160" as="geometry" /></mxCell><mxCell id="m8_pq" value="Por que existe&#10;O encoder não traduz: ele organiza.&#10;Quem escreve português é o decoder, que já sabia a língua antes deste treino." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="2100" width="300" height="160" as="geometry" /></mxCell><mxCell id="m8a" value="Decoder T5 · 12 blocos, pré-treinado em PT&#10;a cada palavra gerada, a cross-attention consulta as 45 posições da memory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2110" width="360" height="80" as="geometry" /></mxCell><mxCell id="m8b" value="“Amanhã eu vou para casa.”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="2120" width="340" height="60" as="geometry" /></mxCell><mxCell id="m8e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m8a" target="m8b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m8c" value="Treino: a frase original é o alvo (cross-entropy com teacher forcing).  Inferência: beam search com 4 feixes, até 64 tokens." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="2205" width="760" height="40" as="geometry" /></mxCell><mxCell id="nm0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m6" target="m7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nm7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#374151;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="m7" target="m8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>