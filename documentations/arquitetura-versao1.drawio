 × 12 blocos&#10;self-attention causal&#10;+ cross-attention sobre memory" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="280" height="85" as="geometry" /></mxCell><mxCell id="d2" value="LM head → logits&#10;(vocabulário PTT5)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="370" width="280" height="55" as="geometry" /></mxCell><mxCell id="ce" value="Treino&#10;Cross-Entropy&#10;(teacher forcing)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="470" width="130" height="70" as="geometry" /></mxCell><mxCell id="gen" value="Inferência&#10;beam search (4)&#10;≤ 64 tokens" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="470" width="130" height="70" as="geometry" /></mxCell><mxCell id="labels" value="Texto alvo (PT)&#10;tokenizer PTT5 → labels&#10;(max_text_len 64)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#075985;fontSize=11;size=0.2;" vertex="1" parent="1"><mxGeometry x="1190" y="250" width="190" height="70" as="geometry" /></mxCell><mxCell id="ltot" value="Perda total&#10;L = CE + λ · CTC&#10;(λ = 0.3 se --use-ctc)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="470" width="190" height="70" as="geometry" /></mxCell><mxCell id="out" value="Tradução em Português" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=12;fontStyle=1;" vertex="1" parent="1